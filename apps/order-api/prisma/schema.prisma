// Harvest Market — customer ordering & billing.
// Inventory arrives from the distributor as JSON (converted from X12) via
// POST /api/integration/inventory. Order/bill events leave through the
// transactional outbox to RabbitMQ (exchange "order.events").

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  company      String?
  passwordHash String
  createdAt    DateTime @default(now())

  orders Order[]
  bills  Bill[]
}

model Product {
  id                    String   @id @default(cuid())
  upc                   String   @unique
  sku                   String
  name                  String
  category              String
  uom                   String
  producerCode          String
  producerName          String
  price                 Float
  available             Int      @default(0)
  active                Boolean  @default(true)
  sourceTransactionId   String?
  sourceTransactionType String?
  sourceEnvelopeIcn     String?
  lastSyncedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orderItems OrderItem[]
}

model InventorySync {
  id                       String   @id @default(cuid())
  distributorTransactionId String   @unique
  deliveryId               String
  transactionType          String
  envelopeIcn              String
  producerName             String
  itemCount                Int
  payload                  Json
  receivedAt               DateTime @default(now())
}

model Order {
  id          String    @id @default(cuid())
  orderNumber String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  status      String    // PLACED | CANCELLED
  subtotal    Float
  total       Float
  notes       String?
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  items OrderItem[]
  bill  Bill?
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  upc       String
  sku       String
  name      String
  uom       String
  quantity  Int
  unitPrice Float
  lineTotal Float
}

model Bill {
  id         String    @id @default(cuid())
  billNumber String    @unique
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  amount     Float
  status     String    // OPEN | PAID | CANCELLED
  issuedAt   DateTime  @default(now())
  dueDate    DateTime
  paidAt     DateTime?
}

model OutboxEvent {
  id          String    @id @default(cuid())
  routingKey  String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, createdAt])
}

model Sequence {
  name  String @id
  value Int
}
