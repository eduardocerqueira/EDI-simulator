// Harvest Hub Distribution — EDI gateway + inventory database.
//
// Traceability chain (every row links back to the raw X12 file):
//   FileTransfer ─▶ Interchange (ISA/IEA) ─▶ FunctionalGroup (GS/GE) ─▶ TransactionSet (ST/SE)
//        │               ├─ ValidationIssue (TA1 / AK9 / AK5 / AK3 / AK4 / business)
//        │               ├─ ProcessingEvent (timeline)
//        │               └─ Acknowledgment (TA1 / 997 sent back over FTP)
//        └─ TransactionSet ─▶ InventoryMovement ─▶ Product
//                          └─ ApiDelivery ─▶ ApiDeliveryAttempt (JSON pushed to the order app)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model TradingPartner {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  isaQualifier String
  isaId        String   @unique
  gsCode       String
  ftpUser      String   @unique
  specialty    String?
  city         String?
  state        String?
  active       Boolean  @default(true)
  contactName  String?
  contactEmail String?
  createdAt    DateTime @default(now())

  products      Product[]
  files         FileTransfer[]
  interchanges  Interchange[]
  transactions  TransactionSet[]
  actionItems   ActionItem[]
  reports       ProducerReport[]
  emails        EmailMessage[]
}

model FileTransfer {
  id           String    @id @default(cuid())
  partnerId    String?
  partner      TradingPartner? @relation(fields: [partnerId], references: [id])
  direction    String    // INBOUND | OUTBOUND
  protocol     String    @default("FTP")
  fileName     String
  remotePath   String
  archivePath  String?
  sizeBytes    Int       @default(0)
  sha256       String?
  status       String    // DISCOVERED | RETRYING | DOWNLOADED | PROCESSED | FAILED | SENT | PENDING
  attempts     Int       @default(0)
  lastError    String?
  content      String?
  discoveredAt DateTime  @default(now())
  transferredAt DateTime?
  processedAt  DateTime?

  interchanges    Interchange[]
  acknowledgments Acknowledgment[]
  events          ProcessingEvent[]

  @@index([direction, discoveredAt])
  @@index([remotePath, status])
}

model Interchange {
  id                 String    @id @default(cuid())
  fileTransferId     String
  fileTransfer       FileTransfer @relation(fields: [fileTransferId], references: [id])
  partnerId          String?
  partner            TradingPartner? @relation(fields: [partnerId], references: [id])
  senderQualifier    String    @default("")
  senderId           String    @default("")
  receiverQualifier  String    @default("")
  receiverId         String    @default("")
  controlNumber      String    @default("")
  interchangeDate    String    @default("")
  interchangeTime    String    @default("")
  version            String    @default("")
  usageIndicator     String    @default("")
  ackRequested       String    @default("")
  elementSeparator   String    @default("")
  componentSeparator String    @default("")
  segmentTerminator  String    @default("")
  isaLength          Int?
  declaredGroupCount String?
  trailerControlNumber String?
  groupCount         Int       @default(0)
  transactionCount   Int       @default(0)
  acceptedCount      Int       @default(0)
  segmentCount       Int       @default(0)
  status             String    // RECEIVED | ACCEPTED | PARTIALLY_ACCEPTED | REJECTED | ERROR
  ta1AckCode         String?
  ta1NoteCode        String?
  rawIsa             String?
  rawIea             String?
  errorCount         Int       @default(0)
  processingMs       Int?
  receivedAt         DateTime  @default(now())
  processedAt        DateTime?

  groups          FunctionalGroup[]
  transactions    TransactionSet[]
  issues          ValidationIssue[]
  events          ProcessingEvent[]
  acknowledgments Acknowledgment[]
  notifications   Notification[]
  actionItem      ActionItem?

  @@index([senderId, controlNumber])
  @@index([receivedAt])
  @@index([status])
}

model FunctionalGroup {
  id                String   @id @default(cuid())
  interchangeId     String
  interchange       Interchange @relation(fields: [interchangeId], references: [id], onDelete: Cascade)
  index             Int
  functionalId      String
  senderCode        String
  receiverCode      String
  date              String
  time              String
  controlNumber     String
  version           String
  declaredTransactionCount String?
  transactionCount  Int
  acceptedCount     Int
  ackCode           String   // A | P | R
  ak9Codes          String[]
  rawGs             String?
  rawGe             String?

  transactions TransactionSet[]
  issues       ValidationIssue[]
}

model TransactionSet {
  id              String    @id @default(cuid())
  interchangeId   String
  interchange     Interchange @relation(fields: [interchangeId], references: [id], onDelete: Cascade)
  groupId         String
  group           FunctionalGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  partnerId       String?
  partner         TradingPartner? @relation(fields: [partnerId], references: [id])
  index           Int
  type            String
  typeName        String?
  controlNumber   String
  segmentCount    Int
  declaredSegmentCount String?
  status          String    // RECEIVED | ENVELOPE_REJECTED | SYNTAX_REJECTED | BUSINESS_REJECTED | INGESTED | DELIVERED | DELIVERY_FAILED | ERROR
  ackCode         String?   // 997 AK5: A | R
  ak5Codes        String[]
  raw             String
  x12Json         Json?
  normalizedJson  Json?
  errorCount      Int       @default(0)
  itemCount       Int       @default(0)
  receivedAt      DateTime  @default(now())
  validatedAt     DateTime?
  ingestedAt      DateTime?
  deliveredAt     DateTime?

  issues     ValidationIssue[]
  events     ProcessingEvent[]
  deliveries ApiDelivery[]
  movements  InventoryMovement[]
  products   Product[]

  @@index([status])
  @@index([type])
  @@index([receivedAt])
}

model ValidationIssue {
  id              String   @id @default(cuid())
  interchangeId   String
  interchange     Interchange @relation(fields: [interchangeId], references: [id], onDelete: Cascade)
  groupId         String?
  group           FunctionalGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     TransactionSet? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  level           String   // INTERCHANGE | GROUP | TRANSACTION | SEGMENT | ELEMENT | BUSINESS
  severity        String
  code            String
  x12Code         String?
  x12CodeSource   String
  message         String
  segmentId       String?
  segmentPosition Int?
  elementPosition Int?
  elementRef      String?
  badValue        String?
  loopId          String?
  createdAt       DateTime @default(now())

  @@index([code])
  @@index([createdAt])
}

model ProcessingEvent {
  id             String   @id @default(cuid())
  fileTransferId String?
  fileTransfer   FileTransfer? @relation(fields: [fileTransferId], references: [id], onDelete: Cascade)
  interchangeId  String?
  interchange    Interchange? @relation(fields: [interchangeId], references: [id], onDelete: Cascade)
  transactionId  String?
  transaction    TransactionSet? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  stage          String
  status         String   // SUCCESS | FAILURE | INFO | RETRY
  message        String
  details        Json?
  durationMs     Int?
  createdAt      DateTime @default(now())

  @@index([interchangeId])
  @@index([transactionId])
}

model Acknowledgment {
  id             String    @id @default(cuid())
  interchangeId  String
  interchange    Interchange @relation(fields: [interchangeId], references: [id], onDelete: Cascade)
  fileTransferId String?
  fileTransfer   FileTransfer? @relation(fields: [fileTransferId], references: [id])
  type           String    // TA1 | 997
  controlNumber  String
  ackCode        String
  fileName       String
  remotePath     String
  content        String
  status         String    // PENDING | SENT | FAILED
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
}

model ApiDelivery {
  id             String    @id @default(cuid())
  transactionId  String
  transaction    TransactionSet @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  target         String    @default("ORDER_API")
  endpoint       String
  payload        Json
  status         String    // PENDING | RETRYING | SUCCESS | DEAD
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  nextAttemptAt  DateTime  @default(now())
  lastError      String?
  lastStatusCode Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  attemptLog ApiDeliveryAttempt[]

  @@index([status, nextAttemptAt])
}

model ApiDeliveryAttempt {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   ApiDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNo  Int
  statusCode Int?
  success    Boolean
  error      String?
  durationMs Int
  createdAt  DateTime @default(now())
}

model Product {
  id                String   @id @default(cuid())
  partnerId         String
  partner           TradingPartner @relation(fields: [partnerId], references: [id])
  upc               String   @unique
  sku               String
  name              String
  category          String
  uom               String
  pack              Int?
  size              Float?
  unitCost          Float
  sellPrice         Float
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  lastTransactionId String?
  lastTransaction   TransactionSet? @relation(fields: [lastTransactionId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  movements InventoryMovement[]
}

model InventoryMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   TransactionSet? @relation(fields: [transactionId], references: [id])
  orderNumber   String?
  type          String   // CATALOG | INVENTORY_ADVICE | RECEIPT | ORDER_PLACED | ORDER_CANCELLED
  quantityDelta Int
  quantityAfter Int
  unitCost      Float?
  note          String?
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
}

model Notification {
  id            String   @id @default(cuid())
  type          String   // routing key
  severity      String   // INFO | WARNING | ERROR
  title         String
  message       String
  source        String   @default("rabbitmq")
  payload       Json?
  interchangeId String?
  interchange   Interchange? @relation(fields: [interchangeId], references: [id], onDelete: SetNull)
  transactionId String?
  orderNumber   String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([read, createdAt])
}

// ---- Replica of the order app (built from order.events messages) ----

model Customer {
  id         String   @id // id from the order app
  name       String
  email      String
  company    String?
  createdAt  DateTime
  syncedAt   DateTime @default(now())

  orders CustomerOrder[]
  bills  Bill[]
}

model CustomerOrder {
  id          String    @id // id from the order app
  orderNumber String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  status      String
  subtotal    Float
  total       Float
  itemCount   Int
  items       Json
  createdAt   DateTime
  cancelledAt DateTime?
  syncedAt    DateTime  @default(now())
}

model Bill {
  id         String    @id // id from the order app
  billNumber String    @unique
  orderId    String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  amount     Float
  status     String
  issuedAt   DateTime
  dueDate    DateTime
  paidAt     DateTime?
  syncedAt   DateTime  @default(now())
}

model OrderEventLog {
  id         String   @id @default(cuid())
  eventId    String   @unique
  routingKey String
  payload    Json
  receivedAt DateTime @default(now())
}

model Sequence {
  name  String @id
  value Int
}

// ---------------------------------------------------------------------------
// EDI failure backlog and producer communication
// ---------------------------------------------------------------------------

/** One backlog entry per failed inbound interchange (envelope, syntax or business rejection). */
model ActionItem {
  id               String    @id @default(cuid())
  number           Int       @unique            // AI-000123 (from the Sequence table)
  partnerId        String
  partner          TradingPartner @relation(fields: [partnerId], references: [id])
  interchangeId    String    @unique
  interchange      Interchange @relation(fields: [interchangeId], references: [id], onDelete: Cascade)
  kind             String    // INTERCHANGE_REJECTED | TRANSACTIONS_REJECTED | PROCESSING_ERROR
  layer            String    // ENVELOPE | SYNTAX | BUSINESS | SYSTEM (worst layer found)
  title            String
  errorCodes       String[]
  issueCount       Int       @default(0)
  failedTransactions Int     @default(0)
  priority         String    // HIGH | MEDIUM | LOW
  status           String    @default("OPEN") // OPEN | IN_PROGRESS | REPORTED | PRODUCER_REPLIED | RESOLVED | DISMISSED
  assignee         String?
  note             String?
  history          Json      @default("[]")   // [{ at, by, action, from?, to?, note? }]
  occurredAt       DateTime                    // when the interchange arrived
  reportedAt       DateTime?
  repliedAt        DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reports ProducerReport[]

  @@index([status, priority])
  @@index([partnerId, status])
  @@index([occurredAt])
}

/** A failure report generated for one producer (the snapshot that was e-mailed). */
model ProducerReport {
  id          String    @id @default(cuid())
  number      Int       @unique            // RPT-000123
  partnerId   String
  partner     TradingPartner @relation(fields: [partnerId], references: [id])
  filters     Json                          // what the admin selected when generating it
  periodFrom  DateTime
  periodTo    DateTime
  summary     Json                          // totals, codes breakdown
  csv         String                        // attachment content
  createdBy   String
  createdAt   DateTime  @default(now())

  items  ActionItem[]
  emails EmailMessage[]

  @@index([partnerId, createdAt])
}

/** Outbound and inbound e-mail through the (simulated) Resend integration. */
model EmailMessage {
  id             String    @id @default(cuid())
  provider       String    @default("resend")
  providerId     String    @unique          // Resend email id
  direction      String    // OUTBOUND | INBOUND
  status         String    // queued | sent | delivered | opened | bounced | complained | failed | received | quarantined
  fromAddr       String
  to             String[]
  cc             String[]
  replyTo        String?
  subject        String
  text           String
  html           String?
  attachments    Json      @default("[]")  // [{ filename, contentType, size, content? }]
  idempotencyKey String?   @unique
  senderVerified Boolean   @default(true)  // inbound: sender is a known producer contact
  partnerId      String?
  partner        TradingPartner? @relation(fields: [partnerId], references: [id])
  reportId       String?
  report         ProducerReport? @relation(fields: [reportId], references: [id])
  inReplyToId    String?
  inReplyTo      EmailMessage?  @relation("EmailThread", fields: [inReplyToId], references: [id])
  replies        EmailMessage[] @relation("EmailThread")
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  bouncedAt      DateTime?
  receivedAt     DateTime?

  events EmailEvent[]

  @@index([direction, createdAt])
  @@index([partnerId, createdAt])
}

/** Every webhook delivery received from Resend (verified or not) — the integration audit log. */
model EmailEvent {
  id          String    @id @default(cuid())
  svixId      String    @unique               // idempotency: Resend may deliver the same webhook twice
  type        String                          // email.sent | email.delivered | email.opened | email.bounced | email.complained | email.received
  emailId     String?
  email       EmailMessage? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  providerEmailId String?
  verified    Boolean
  outcome     String                          // processed | duplicate | rejected | ignored
  error       String?
  payload     Json
  receivedAt  DateTime  @default(now())

  @@index([receivedAt])
}
